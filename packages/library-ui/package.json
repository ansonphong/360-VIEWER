{
  "name": "@phong/360-library-ui",
  "version": "5.0.0",
  "description": "Batteries-included sidebar/toolbar/info-bar for 360 panorama experiences",
  "license": "MIT",
  "main": "./dist/library-ui.umd.js",
  "module": "./dist/library-ui.esm.js",
  "types": "./dist/library-ui.d.ts",
