{
  "name": "@phong/360-engine",
  "version": "5.0.0-rc.1",
  "description": "Headless 360 panorama renderer — no DOM beyond canvas",
  "license": "MIT",
  "main": "./dist/engine.umd.js",
  "module": "./dist/engine.esm.js",
  "types": "./dist/engine.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.esm.js",
      "require": "./dist/engine.umd.js"
    },
    "./engine.css": "./dist/engine.css"
  },
  "peerDependencies": {
    "three": "^0.128.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:types": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
